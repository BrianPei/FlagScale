# FlagScale training image for Hygon BW1000 DCUs. The vendor base supplies DTK
# and PyTorch. The FlagOS Transformer Engine implementation is installed below;
# FlagScale is checked out at test time so one image can exercise PR revisions.

ARG BASE_IMAGE=harbor.sourcefind.cn:5443/dcu/admin/base/vllm:0.15.1-ubuntu22.04-dtk26.04-py3.10
ARG PYTHON_VERSION=3.10
ARG MEGATRON_REF=409c1ed949675ddf9aa540aaae48652f446351cc
ARG FLAGGEMS_REF=f7ae8e6b934a33ec1ccaf2c9aae71edf205f8fb4
ARG TRANSFORMER_ENGINE_REF=94c7007c84107028919b4e52213d1bcb4ca3f7cf

FROM ${BASE_IMAGE} AS base

ARG PYTHON_VERSION
ARG MEGATRON_REF
ARG FLAGGEMS_REF
ARG TRANSFORMER_ENGINE_REF

LABEL io.flagscale.platform=hygon-bw1000 \
      io.flagscale.megatron-lm-fl.revision=${MEGATRON_REF} \
      io.flagscale.flaggems.revision=${FLAGGEMS_REF} \
      io.flagscale.transformer-engine-fl.revision=${TRANSFORMER_ENGINE_REF}

ENV FLAGSCALE_HOME=/opt/flagscale \
    FLAGSCALE_DEPS=/opt/flagscale/deps \
    CUDA_PATH=/opt/dtk/cuda/cuda-12 \
    CUDA_HOME=/opt/dtk/cuda/cuda-12 \
    DEVICE_HOME=/opt/dtk/cuda/cuda-12 \
    CCL_HOME=/opt/dtk/cuda/cuda-12 \
    TE_FL_SKIP_CUDA=1 \
    TORCHINDUCTOR_WORKER_START=spawn \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        python3-dev && \
    rm -rf /var/lib/apt/lists/* && \
    git config --system http.version HTTP/1.1 && \
    python -c "import sys; expected='${PYTHON_VERSION}'; actual=f'{sys.version_info.major}.{sys.version_info.minor}'; assert actual == expected, f'expected Python {expected}, found {actual}'"

WORKDIR /workspace

FROM base AS deps

ARG MEGATRON_REF
ARG FLAGGEMS_REF
ARG TRANSFORMER_ENGINE_REF
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PIP_INDEX_URL=${PIP_INDEX_URL}

COPY requirements/common.txt /tmp/requirements/common.txt
COPY requirements/hygon /tmp/requirements/hygon

RUN set -eux; \
    python -c "from pathlib import Path; import torch; Path('/tmp/flagscale-vendor-torch').write_text(torch.__version__ + '\\n' + torch.__file__); Path('/tmp/flagscale-torch-constraint.txt').write_text('torch==' + torch.__version__ + '\\n')"; \
    python -m pip install \
        "setuptools>=64.0,<77.0" \
        "setuptools-scm>=8.0,<10.0" \
        "wheel==0.46.2" \
        "cmake>=3.21,<4.0" \
        "ninja==1.13.0" \
        "scikit-build-core==0.12.2" \
        "pybind11[global]==3.0.3"; \
    python -m pip install \
        --constraint /tmp/flagscale-torch-constraint.txt \
        --requirement /tmp/requirements/hygon/train.txt

RUN set -eux; \
    mkdir -p "${FLAGSCALE_DEPS}/Megatron-LM-FL"; \
    curl --http1.1 --fail --location --retry 20 --retry-all-errors --retry-delay 5 --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
        --output /tmp/megatron-lm-fl.tar.gz \
        "https://codeload.github.com/flagos-ai/Megatron-LM-FL/tar.gz/${MEGATRON_REF}"; \
    tar -xzf /tmp/megatron-lm-fl.tar.gz --strip-components=1 \
        -C "${FLAGSCALE_DEPS}/Megatron-LM-FL"; \
    rm /tmp/megatron-lm-fl.tar.gz; \
    python -m pip install --ignore-requires-python --no-build-isolation --no-deps \
        -e "${FLAGSCALE_DEPS}/Megatron-LM-FL"; \
    python -m pip show megatron-core >/dev/null

RUN set -eux; \
    mkdir -p "${FLAGSCALE_DEPS}/FlagGems"; \
    curl --http1.1 --fail --location --retry 20 --retry-all-errors --retry-delay 5 --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
        --output /tmp/flag-gems.tar.gz \
        "https://codeload.github.com/flagos-ai/FlagGems/tar.gz/${FLAGGEMS_REF}"; \
    tar -xzf /tmp/flag-gems.tar.gz --strip-components=1 \
        -C "${FLAGSCALE_DEPS}/FlagGems"; \
    rm /tmp/flag-gems.tar.gz; \
    python -m pip install --no-build-isolation --no-deps \
        -e "${FLAGSCALE_DEPS}/FlagGems"

RUN set -eux; \
    mkdir -p "${FLAGSCALE_DEPS}/TransformerEngine-FL"; \
    curl --http1.1 --fail --location --retry 20 --retry-all-errors --retry-delay 5 --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
        --output /tmp/transformer-engine-fl.tar.gz \
        "https://codeload.github.com/flagos-ai/TransformerEngine-FL/tar.gz/${TRANSFORMER_ENGINE_REF}"; \
    tar -xzf /tmp/transformer-engine-fl.tar.gz --strip-components=1 \
        -C "${FLAGSCALE_DEPS}/TransformerEngine-FL"; \
    rm /tmp/transformer-engine-fl.tar.gz; \
    TE_FL_SKIP_CUDA=1 python -m pip install --no-build-isolation --no-deps \
        -e "${FLAGSCALE_DEPS}/TransformerEngine-FL"; \
    python -m pip show transformer-engine >/dev/null; \
    python -c "from pathlib import Path; import torch; expected=Path('/tmp/flagscale-vendor-torch').read_text().splitlines(); actual=[torch.__version__, torch.__file__]; assert actual == expected, f'vendor torch changed: expected {expected}, found {actual}'"; \
    rm /tmp/flagscale-vendor-torch /tmp/flagscale-torch-constraint.txt

FROM deps AS dev

ENTRYPOINT []
CMD ["/bin/bash"]

FROM deps AS release

ENTRYPOINT []
CMD ["/bin/bash"]
