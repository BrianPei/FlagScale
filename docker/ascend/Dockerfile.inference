# This immutable base was built from quay.io/ascend/vllm-ascend:v0.20.2rc1-a3
# with FlagGems 3e6528cf04f5f964a7b0fa6628de6f0410dbfd02.
ARG BASE_IMAGE=harbor.baai.ac.cn/flagscale/vllm-plugin-fl@sha256:5062ac23b8b8247e5b4faa5d2c61b7b8e82e46a9ae7c55fe15c5cdbe3533f4b7

FROM ${BASE_IMAGE}

ARG VLLM_PLUGIN_FL_REF=43edeb601f4b8f616f56109de64836529e758deb
ARG FLAGGEMS_REF=3e6528cf04f5f964a7b0fa6628de6f0410dbfd02

LABEL io.flagscale.vllm-plugin-fl.revision=${VLLM_PLUGIN_FL_REF} \
      io.flagscale.flaggems.revision=${FLAGGEMS_REF}

ENV VLLM_PLUGINS=fl \
    VLLM_FL_PLATFORM=ascend \
    TRITON_ALL_BLOCKS_PARALLEL=1

COPY vllm-plugin-FL /tmp/vllm-plugin-FL

# The upstream Ascend base currently contains unrelated pip-check findings.
# Record that immutable baseline and fail if installing the pinned plugin adds
# any new dependency inconsistency.
RUN python -m pip check 2>&1 | sort > /tmp/pip-check.before || true

RUN python -m pip install --no-cache-dir --no-build-isolation --no-deps \
        /tmp/vllm-plugin-FL && \
    rm -rf /tmp/vllm-plugin-FL

# Validate package metadata and vLLM's standard plugin entry point. Hardware
# platform activation is verified after build with the host driver mounted.
RUN python -m pip check 2>&1 | sort > /tmp/pip-check.after || true; \
    diff -u /tmp/pip-check.before /tmp/pip-check.after && \
    cat /tmp/pip-check.after && \
    rm -f /tmp/pip-check.before /tmp/pip-check.after && \
    python -c 'import importlib.metadata as metadata; \
vllm_version = metadata.version("vllm"); \
plugin_version = metadata.version("vllm-plugin-fl"); \
print("vllm:", vllm_version); \
print("plugin:", plugin_version); \
assert vllm_version.startswith("0.20.2"), vllm_version; \
platform_plugins = {ep.name: ep.value for ep in metadata.entry_points(group="vllm.platform_plugins")}; \
print("platform_plugins:", platform_plugins); \
assert platform_plugins.get("fl") == "vllm_fl:register", platform_plugins'

WORKDIR /workspace
