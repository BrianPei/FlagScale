# FlagScale all-in-one image for Huawei Ascend NPUs.
#
# Training and inference require incompatible Python, PyTorch, torch_npu and
# CANN versions. They are built in separate stages and remain isolated in the
# final image instead of forcing both dependency graphs into one environment.

ARG TRAIN_BASE_IMAGE=harbor.baai.ac.cn/flagos-dev/megatron-lm-fl:manual-20260717-ascend-dev
ARG INFERENCE_BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.13.0rc1-a3
ARG PKG_MGR=pip
ARG FLAGSCALE_HOME=/opt/flagscale
ARG FLAGSCALE_TE_REPO=https://github.com/flagos-ai/TransformerEngine-FL.git
ARG FLAGSCALE_TE_REF=771a7488fc01c50f7714b8c6162f6bbfe451608a
ARG FLAGSCALE_MEGATRON_REPO=https://github.com/flagos-ai/Megatron-LM-FL.git
ARG FLAGSCALE_MEGATRON_REF=175ae90ec92a9e6fea2d74ccd24d6a1835d3ae82

FROM ${TRAIN_BASE_IMAGE} AS train-base

ARG FLAGSCALE_HOME
ARG FLAGSCALE_TE_REF
ARG FLAGSCALE_MEGATRON_REF

LABEL io.flagscale.transformer-engine-fl.revision=${FLAGSCALE_TE_REF} \
      io.flagscale.megatron-lm-fl.revision=${FLAGSCALE_MEGATRON_REF}

ENV FLAGSCALE_HOME=${FLAGSCALE_HOME} \
    FLAGSCALE_DEPS=${FLAGSCALE_HOME}/deps \
    FLAGSCALE_DOWNLOADS=${FLAGSCALE_HOME}/downloads \
    FS_PLATFORM=npu \
    UV_HTTP_TIMEOUT=500 \
    PATH="${FLAGSCALE_HOME}/venv/bin:/root/.local/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git ninja-build && \
    rm -rf /var/lib/apt/lists/*

COPY tools/install/ascend/env.sh /etc/profile.d/flagscale-env.sh
COPY tools/install /workspace/tools/install
COPY requirements /workspace/requirements
WORKDIR /workspace

FROM train-base AS train-dev-runtime

ARG PKG_MGR
ARG FLAGSCALE_TE_REPO
ARG FLAGSCALE_TE_REF
ARG FLAGSCALE_MEGATRON_REPO
ARG FLAGSCALE_MEGATRON_REF
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    FLAGSCALE_TE_REPO=${FLAGSCALE_TE_REPO} \
    FLAGSCALE_TE_REF=${FLAGSCALE_TE_REF} \
    FLAGSCALE_MEGATRON_REPO=${FLAGSCALE_MEGATRON_REPO} \
    FLAGSCALE_MEGATRON_REF=${FLAGSCALE_MEGATRON_REF}

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/opt/flagscale/downloads,sharing=locked \
    . /etc/profile.d/flagscale-env.sh && \
    chmod +x /workspace/tools/install/*.sh \
        /workspace/tools/install/utils/*.sh \
        /workspace/tools/install/ascend/*.sh && \
    ./tools/install/install.sh --platform ascend --task train \
        --pkg-mgr ${PKG_MGR} --no-system --force-build && \
    rm -rf /workspace/*

FROM train-base AS train-release-runtime

ARG PKG_MGR
ARG FLAGSCALE_TE_REPO
ARG FLAGSCALE_TE_REF
ARG FLAGSCALE_MEGATRON_REPO
ARG FLAGSCALE_MEGATRON_REF
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    FLAGSCALE_TE_REPO=${FLAGSCALE_TE_REPO} \
    FLAGSCALE_TE_REF=${FLAGSCALE_TE_REF} \
    FLAGSCALE_MEGATRON_REPO=${FLAGSCALE_MEGATRON_REPO} \
    FLAGSCALE_MEGATRON_REF=${FLAGSCALE_MEGATRON_REF}

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/opt/flagscale/downloads,sharing=locked \
    . /etc/profile.d/flagscale-env.sh && \
    chmod +x /workspace/tools/install/*.sh \
        /workspace/tools/install/utils/*.sh \
        /workspace/tools/install/ascend/*.sh && \
    ./tools/install/install.sh --platform ascend --task train \
        --pkg-mgr ${PKG_MGR} --no-system --no-dev --force-build && \
    rm -rf /workspace/*

FROM ${INFERENCE_BASE_IMAGE} AS inference-base

ARG FLAGSCALE_HOME

ENV FLAGSCALE_HOME=${FLAGSCALE_HOME} \
    FLAGSCALE_DEPS=${FLAGSCALE_HOME}/deps \
    FLAGSCALE_DOWNLOADS=${FLAGSCALE_HOME}/downloads \
    FS_PLATFORM=npu \
    VLLM_PLUGINS=fl \
    TRITON_ALL_BLOCKS_PARALLEL=1 \
    UV_HTTP_TIMEOUT=500 \
    PATH="${FLAGSCALE_HOME}/venv/bin:/root/.local/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git ninja-build && \
    rm -rf /var/lib/apt/lists/*

COPY tools/install/ascend/env.sh /etc/profile.d/flagscale-env.sh
COPY tools/install /workspace/tools/install
COPY requirements /workspace/requirements
WORKDIR /workspace

FROM inference-base AS inference-dev-runtime

ARG PKG_MGR
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/opt/flagscale/downloads,sharing=locked \
    . /etc/profile.d/flagscale-env.sh && \
    chmod +x /workspace/tools/install/*.sh \
        /workspace/tools/install/utils/*.sh \
        /workspace/tools/install/ascend/*.sh && \
    ./tools/install/install.sh --platform ascend --task inference \
        --pkg-mgr ${PKG_MGR} --no-system && \
    ./tools/install/install.sh --platform ascend --task serve \
        --pkg-mgr ${PKG_MGR} --no-system --no-dev --no-base && \
    rm -rf /workspace/*

FROM inference-base AS inference-release-runtime

ARG PKG_MGR
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}

RUN --mount=type=cache,target=/root/.cache/pip \
    . /etc/profile.d/flagscale-env.sh && \
    chmod +x /workspace/tools/install/*.sh \
        /workspace/tools/install/utils/*.sh \
        /workspace/tools/install/ascend/*.sh && \
    ./tools/install/install.sh --platform ascend --task inference \
        --pkg-mgr ${PKG_MGR} --no-system --no-dev && \
    ./tools/install/install.sh --platform ascend --task serve \
        --pkg-mgr ${PKG_MGR} --no-system --no-dev --no-base && \
    rm -rf /workspace/*

FROM inference-dev-runtime AS dev

ARG FLAGSCALE_HOME

COPY --from=train-dev-runtime /usr/local/python3.12.13 /usr/local/python3.12.13
COPY --from=train-dev-runtime /usr/local/Ascend/cann-9.0.0 /usr/local/Ascend/cann-9.0.0
COPY --from=train-dev-runtime /usr/local/Ascend/nnal ${FLAGSCALE_HOME}/runtimes/train/nnal
COPY --from=train-dev-runtime ${FLAGSCALE_HOME}/deps ${FLAGSCALE_HOME}/deps
COPY tools/install/ascend/activate_runtime.sh ${FLAGSCALE_HOME}/runtimes/train/activate.sh
COPY tools/install/ascend/activate_runtime.sh ${FLAGSCALE_HOME}/runtimes/inference/activate.sh

RUN chmod 0755 ${FLAGSCALE_HOME}/runtimes/train/activate.sh \
        ${FLAGSCALE_HOME}/runtimes/inference/activate.sh && \
    ln -s inference ${FLAGSCALE_HOME}/runtimes/serve

CMD ["/bin/bash"]

FROM inference-release-runtime AS release

ARG FLAGSCALE_HOME

COPY --from=train-release-runtime /usr/local/python3.12.13 /usr/local/python3.12.13
COPY --from=train-release-runtime /usr/local/Ascend/cann-9.0.0 /usr/local/Ascend/cann-9.0.0
COPY --from=train-release-runtime /usr/local/Ascend/nnal ${FLAGSCALE_HOME}/runtimes/train/nnal
COPY --from=train-release-runtime ${FLAGSCALE_HOME}/deps ${FLAGSCALE_HOME}/deps
COPY tools/install/ascend/activate_runtime.sh ${FLAGSCALE_HOME}/runtimes/train/activate.sh
COPY tools/install/ascend/activate_runtime.sh ${FLAGSCALE_HOME}/runtimes/inference/activate.sh

RUN chmod 0755 ${FLAGSCALE_HOME}/runtimes/train/activate.sh \
        ${FLAGSCALE_HOME}/runtimes/inference/activate.sh && \
    ln -s inference ${FLAGSCALE_HOME}/runtimes/serve

CMD ["/bin/bash"]
