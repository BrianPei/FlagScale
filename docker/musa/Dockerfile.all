# FlagScale all-in-one image for MThreads MUSA. The vendor Torch/MUSA runtime
# remains shared through system-site-packages, while FlagScale dependencies are
# installed into task-owned venvs.
ARG BASE_IMAGE=harbor.baai.ac.cn/flagos-dev/transformerengine-fl:manual-20260802-musa-torch2.7.1-e73781e-vllm29ceebd
ARG PKG_MGR=pip
ARG FLAGSCALE_HOME=/opt/flagscale
ARG PIP_DEFAULT_TIMEOUT=300
ARG FLAGSCALE_MEGATRON_REPO=https://github.com/flagos-ai/Megatron-LM-FL.git
ARG FLAGSCALE_MEGATRON_REF=main
ARG FLAGSCALE_TE_VERSION=2.0.0+e73781e

FROM ${BASE_IMAGE} AS base
ARG FLAGSCALE_HOME
ARG PIP_DEFAULT_TIMEOUT
ARG FLAGSCALE_MEGATRON_REF
ENV FLAGSCALE_HOME=${FLAGSCALE_HOME} \
    FLAGSCALE_DEPS=${FLAGSCALE_HOME}/deps \
    FLAGSCALE_DOWNLOADS=${FLAGSCALE_HOME}/downloads \
    PIP_DEFAULT_TIMEOUT=${PIP_DEFAULT_TIMEOUT} \
    FS_PLATFORM=musa \
    MUSA_HOME=/usr/local/musa \
    MPI_HOME=/usr/local/openmpi \
    PATH="/usr/local/musa/bin:/usr/local/openmpi/bin:/root/.local/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/musa/lib:/usr/local/openmpi/lib:/usr/local/lib:${LD_LIBRARY_PATH}"
LABEL io.flagscale.megatron-lm-fl.revision=${FLAGSCALE_MEGATRON_REF} \
      io.flagscale.runtime.layout=task-isolated \
      io.flagscale.runtime.train=/opt/flagscale/runtimes/train \
      io.flagscale.runtime.inference=/opt/flagscale/runtimes/inference \
      io.flagscale.runtime.serve=/opt/flagscale/runtimes/serve
COPY tools/install/musa/env.sh /etc/profile.d/flagscale-env.sh
COPY tools/install/musa/activate_runtime.sh /opt/flagscale/bin/activate-musa-runtime.sh
WORKDIR /workspace

FROM base AS deps
ARG PKG_MGR
ARG FLAGSCALE_HOME
ARG FLAGSCALE_MEGATRON_REPO
ARG FLAGSCALE_MEGATRON_REF
ARG FLAGSCALE_TE_VERSION
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy=${HTTP_PROXY}
ARG https_proxy=${HTTPS_PROXY}
ARG no_proxy=${NO_PROXY}
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    FLAGSCALE_MEGATRON_REPO=${FLAGSCALE_MEGATRON_REPO} \
    FLAGSCALE_MEGATRON_REF=${FLAGSCALE_MEGATRON_REF} \
    FLAGSCALE_TE_VERSION=${FLAGSCALE_TE_VERSION}
COPY tools/install /workspace/tools/install
COPY requirements /workspace/requirements
RUN --mount=type=cache,target=/root/.cache/pip \
    chmod +x /workspace/tools/install/*.sh /workspace/tools/install/utils/*.sh /workspace/tools/install/musa/*.sh && \
    if [ "$PKG_MGR" != "pip" ]; then \
        echo "MUSA all requires PKG_MGR=pip with isolated runtime venvs" >&2; \
        exit 1; \
    fi; \
    mkdir -p /opt/flagscale/runtimes/train /opt/flagscale/runtimes/inference /opt/flagscale/runtimes/serve; \
    python3 -m venv --system-site-packages /opt/flagscale/runtimes/train/venv; \
    python3 -m venv --system-site-packages /opt/flagscale/runtimes/inference/venv; \
    printf '%s\n' train > /opt/flagscale/runtimes/train/task; \
    printf '%s\n' inference > /opt/flagscale/runtimes/inference/task; \
    printf '%s\n' serve > /opt/flagscale/runtimes/serve/task; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/train/activate.sh; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/inference/activate.sh; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/serve/activate.sh; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/train \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task train --pkg-mgr pip --no-system'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task inference --pkg-mgr pip --no-system'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task serve --pkg-mgr pip --no-system'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/train \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; \
        python -m pip show transformer-engine >/dev/null'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; \
        python -m pip show vllm >/dev/null'; \
    rm -rf /workspace/*

FROM deps AS dev
CMD ["/bin/bash"]

FROM base AS release
ARG PKG_MGR
ARG FLAGSCALE_HOME
ARG FLAGSCALE_MEGATRON_REPO
ARG FLAGSCALE_MEGATRON_REF
ARG FLAGSCALE_TE_VERSION
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy=${HTTP_PROXY}
ARG https_proxy=${HTTPS_PROXY}
ARG no_proxy=${NO_PROXY}
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    FLAGSCALE_MEGATRON_REPO=${FLAGSCALE_MEGATRON_REPO} \
    FLAGSCALE_MEGATRON_REF=${FLAGSCALE_MEGATRON_REF} \
    FLAGSCALE_TE_VERSION=${FLAGSCALE_TE_VERSION}
COPY tools/install /workspace/tools/install
COPY requirements /workspace/requirements
RUN --mount=type=cache,target=/root/.cache/pip \
    chmod +x /workspace/tools/install/*.sh /workspace/tools/install/utils/*.sh /workspace/tools/install/musa/*.sh && \
    if [ "$PKG_MGR" != "pip" ]; then \
        echo "MUSA all requires PKG_MGR=pip with isolated runtime venvs" >&2; \
        exit 1; \
    fi; \
    mkdir -p /opt/flagscale/runtimes/train /opt/flagscale/runtimes/inference /opt/flagscale/runtimes/serve; \
    python3 -m venv --system-site-packages /opt/flagscale/runtimes/train/venv; \
    python3 -m venv --system-site-packages /opt/flagscale/runtimes/inference/venv; \
    printf '%s\n' train > /opt/flagscale/runtimes/train/task; \
    printf '%s\n' inference > /opt/flagscale/runtimes/inference/task; \
    printf '%s\n' serve > /opt/flagscale/runtimes/serve/task; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/train/activate.sh; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/inference/activate.sh; \
    ln -s /opt/flagscale/bin/activate-musa-runtime.sh /opt/flagscale/runtimes/serve/activate.sh; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/train \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task train --pkg-mgr pip --no-system --no-dev'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task inference --pkg-mgr pip --no-system --no-dev'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; cd /workspace; \
        FLAGSCALE_HOME=${FLAGSCALE_HOME} FLAGSCALE_MUSA_BUILD_NO_DEVICE=true \
        ./tools/install/install.sh --platform musa --task serve --pkg-mgr pip --no-system --no-dev'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/train \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; \
        python -m pip show transformer-engine >/dev/null'; \
    FLAGSCALE_RUNTIME_ROOT=/opt/flagscale/runtimes/inference \
        bash -c '. "$FLAGSCALE_RUNTIME_ROOT/activate.sh"; \
        python -m pip show vllm >/dev/null'; \
    rm -rf /workspace/*
CMD ["/bin/bash"]
