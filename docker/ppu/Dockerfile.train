ARG BASE_IMAGE=harbor.baai.ac.cn/flagos-dev/flagcx:manual-20260827-ppu-dev
FROM ${BASE_IMAGE} AS dev
ARG BASE_IMAGE
ARG FLAGSCALE_MEGATRON_REF
ARG FLAGSCALE_TE_REF
ARG FLAGSCALE_REVISION=unknown
LABEL org.opencontainers.image.base.name=${BASE_IMAGE} \
      org.opencontainers.image.revision=${FLAGSCALE_REVISION} \
      io.flagscale.megatron-lm-fl.revision=${FLAGSCALE_MEGATRON_REF} \
      io.flagscale.transformer-engine-fl.revision=${FLAGSCALE_TE_REF} \
      io.flagscale.ppu.te-backend=reference
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV PATH="/usr/local/PPU_SDK/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/PPU_SDK/CUDA_SDK/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}" \
    TE_FL_SKIP_CUDA=1 TE_FL_PREFER=reference NVTE_FRAMEWORK=pytorch \
    NVTE_FLASH_ATTN=0 NVTE_FUSED_ATTN=0 NVTE_UNFUSED_ATTN=1 \
    NVTE_WITH_NCCL_EP=0 FLAGSCALE_TEST_DIST_BACKEND=nccl \
    FLAGSCALE_TEST_TORCH_DEVICE_TYPE=cuda
COPY tools/install/ppu /opt/flagscale/tools/install/ppu
COPY requirements /opt/flagscale/requirements
RUN cp /opt/flagscale/tools/install/ppu/env.sh /etc/profile.d/flagscale-ppu.sh && \
    bash /opt/flagscale/tools/install/ppu/install_base.sh && \
    bash /opt/flagscale/tools/install/ppu/install_train.sh
# Bake CLI and source into the candidate; acceptance must not install core deps.
WORKDIR /opt/flagscale/source
COPY pyproject.toml setup.py README.md ./
COPY requirements ./requirements
COPY flagscale ./flagscale
COPY tools/install/utils/parse_requirements.py ./tools/install/utils/parse_requirements.py
RUN source /etc/profile.d/flagscale-ppu.sh && \
    python -m pip install --no-build-isolation --no-deps .
WORKDIR /workspace
CMD ["/bin/bash"]
