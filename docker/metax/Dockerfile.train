# FlagScale training image for MetaX C550.
ARG BASE_IMAGE=harbor.baai.ac.cn/flagscale/megatron-lm-with-te@sha256:c6bc75f8512a3ba385339a536a33dfc1dcbeb0c42b6ca1e2d5f0f0e4e9d6200f
ARG FLAGSCALE_HOME=/opt/flagscale
ARG FLAGSCALE_CONDA=/opt/conda
ARG FLAGSCALE_MEGATRON_REF=409c1ed949675ddf9aa540aaae48652f446351cc
ARG FLAGSCALE_TE_REF=94c7007c84107028919b4e52213d1bcb4ca3f7cf

FROM ${BASE_IMAGE} AS base

ARG FLAGSCALE_HOME
ARG FLAGSCALE_CONDA
ARG FLAGSCALE_MEGATRON_REF
ARG FLAGSCALE_TE_REF
LABEL io.flagscale.megatron-lm-fl.revision=${FLAGSCALE_MEGATRON_REF} \
      io.flagscale.transformer-engine-fl.revision=${FLAGSCALE_TE_REF}
ENV FLAGSCALE_HOME=${FLAGSCALE_HOME} \
    FLAGSCALE_CONDA=${FLAGSCALE_CONDA} \
    FLAGSCALE_MEGATRON_REF=${FLAGSCALE_MEGATRON_REF} \
    FLAGSCALE_TE_REF=${FLAGSCALE_TE_REF} \
    PATH="${FLAGSCALE_CONDA}/bin:${PATH}"

COPY tools/install/metax/env.sh /etc/profile.d/flagscale-env.sh
WORKDIR /workspace

FROM base AS dev
COPY tools/install /workspace/tools/install
COPY requirements /workspace/requirements
RUN chmod +x /workspace/tools/install/*.sh \
        /workspace/tools/install/utils/*.sh \
        /workspace/tools/install/metax/*.sh && \
    /workspace/tools/install/install.sh --platform metax --task train \
        --pkg-mgr pip --no-system --no-dev --force-build && \
    rm -rf /workspace/tools /workspace/requirements
CMD ["/bin/bash"]

FROM dev AS release
CMD ["/bin/bash"]
